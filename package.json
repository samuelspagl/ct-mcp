{
  "name": "churchtools-mcp-server",
  "version": "0.2.0",
  "description": "Streamable HTTP MCP server for ChurchTools.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "churchtools",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@churchtools/churchtools-client": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^6.0.2",
    "express": "^4.21.2",
    "tough-cookie": "^5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
