PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CHURCHTOOLS_BASE_URL=https://example.church.tools

# PAT mode: one technical ChurchTools login token configured at deployment time.
CHURCHTOOLS_AUTH_MODE=pat
CHURCHTOOLS_PAT=replace-with-login-token
MCP_SERVER_TOKEN=replace-with-mcp-token

# OAuth mode: per-user ChurchTools authorization.
# CHURCHTOOLS_AUTH_MODE=oauth
# PUBLIC_BASE_URL=https://mcp.example.org
# MCP_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
# TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# CHURCHTOOLS_OAUTH_CLIENT_ID=replace-with-churchtools-oauth-client-id
# CHURCHTOOLS_OAUTH_CLIENT_SECRET=replace-with-churchtools-oauth-client-secret
# CHURCHTOOLS_OAUTH_AUTHORIZE_URL=https://example.church.tools/oauth/authorize
# CHURCHTOOLS_OAUTH_TOKEN_URL=https://example.church.tools/oauth/access_token
# CHURCHTOOLS_OAUTH_PROFILE_URL=https://example.church.tools/oauth/userinfo
# CHURCHTOOLS_OAUTH_SCOPE=
# OAUTH_TOKEN_STORE_PATH=./data/tokens.db
# MCP_ACCESS_TOKEN_TTL_SECONDS=900
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# ALLOW_UNAUTHENTICATED_MCP=false
# CHURCHTOOLS_OPENAPI_URL=https://example.church.tools/system/runtime/swagger/openapi.json
# REQUEST_TIMEOUT_MS=30000
# MAX_RESPONSE_BYTES=100000
